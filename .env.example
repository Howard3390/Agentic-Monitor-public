# Copy to .env and fill in your own values. Never commit the completed .env.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

# SNMP read-only community for the asset in inventory.json
LINUX_SNMP_COMMUNITY=

# Docker inspection via SSH; host must equal the asset host in inventory.json
MONITOR_SSH_HOST=
MONITOR_SSH_PORT=22
MONITOR_SSH_USER=
MONITOR_SSH_PASSWORD=

# MySQL inspection; host must equal the asset host in inventory.json
MONITOR_MYSQL_HOST=
MONITOR_MYSQL_PORT=3306
MONITOR_MYSQL_USER=
MONITOR_MYSQL_PASSWORD=
